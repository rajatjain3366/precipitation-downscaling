{
  "experiment_name": "india_qre_mass_v1",
  "save_dir": "results/india/qre_mass_v1",
  "base_seed": 42,
  "n_intervals": 6,
  "data": {
    "data_dir": "data/India",
    "imd_pattern": "imd/RF25_ind*_rfp25.nc",
    "imd_variable": "RAINFALL",
    "era5_pattern": "era5/*.nc",
    "era5_variables": ["q", "t", "u", "v", "w"],
    "pressure_level": 850.0,
    "coarsen_factor": 4,
    "aggregation_shift_hours": 0,
    "day_offset": 0,
    "period": ["1990-01-01", "2019-12-31"],
    "allow_missing_days": false,
    "standardize_predictors": true,
    "use_elevation": false,
    "input_hw": [32, 33]
  },
  "split": {
    "train": ["1990-01-01", "2010-12-31"],
    "val": ["2011-01-01", "2014-12-31"],
    "test": ["2015-01-01", "2019-12-31"]
  },
  "loss": {
    "rain_threshold": 0.0,
    "epsilon": 0.0001
  },
  "segmentation": {
    "method": "bayesian_gmm",
    "n_runs": 100,
    "seed": 0,
    "weight_concentration_prior": null,
    "intervals_file": null
  },
  "prediction": {
    "mode": "expected"
  },
  "architecture": {
    "channels": [64, 128, 256],
    "kernel": 6,
    "padding": "valid",
    "dense": [512],
    "dense_activation": "relu",
    "dropout": 0.2,
    "attention_reduction": 1,
    "omega_init_conv": true
  },
  "bgnet": {
    "learning_rate": 0.0001,
    "decay_rate": 0.7,
    "decay_steps": 6000,
    "patience": 4,
    "max_epochs": 100,
    "extend_epochs": 50,
    "max_epochs_hard": 100,
    "batch_size": 91
  },
  "members": {
    "init": "scratch",
    "warm_start": {"learning_rate": 0.00005},
    "learning_rate": 0.0001,
    "decay_rate": 0.7,
    "decay_steps": 6000,
    "patience": 4,
    "max_epochs": 100,
    "extend_epochs": 50,
    "max_epochs_hard": 100,
    "batch_size": 91
  },
  "weight_network": {
    "dense": 100,
    "dropout": 0.2,
    "loss": "squared_emd",
    "ce_weight": 1.0,
    "emd_weight": 1.0,
    "emd_reduction": "sum",
    "learning_rate": 0.00005,
    "decay_rate": 0.7,
    "decay_steps": 6000,
    "patience": 15,
    "max_epochs": 100,
    "extend_epochs": 50,
    "max_epochs_hard": 300,
    "batch_size": 91,
    "collapse_fraction": 0.7
  },
  "mass": {
    "placement": "ensemble",
    "mode": "absolute",
    "eps_mm_per_day": 0.1,
    "lambdas": [0, 0.01, 0.1, 1],
    "lambda_scaling": "initial_ratio",
    "scaling_max_days": 512
  },
  "ensemble": {
    "train_members": false,
    "precompute_member_predictions": true,
    "learning_rate": 0.00005,
    "decay_rate": null,
    "decay_steps": 6000,
    "patience": 5,
    "max_epochs": 50,
    "extend_epochs": 0,
    "max_epochs_hard": 50,
    "batch_size": 91
  },
  "selection": {
    "mse_regime": "[0.0,1.0]",
    "mse_tolerance": 0.02,
    "total_metric": "daily_mae_mm_per_day"
  },
  "checkpoints": {
    "dir": "checkpoints/india/qre_mass_v1"
  }
}
